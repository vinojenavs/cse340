<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>
    <form action="/edit-category/<%= categoryDetails.category_id %>" method="post">
        <div class="form-group">
            <label for="name">Category Name</label>
            <input type="text" name="name" id="name" value="<%= categoryDetails.name %>" required maxlength="100">
        </div>
        <button type="submit">Edit Category</button>
    </form>
</main>
<%- include('partials/footer') %>