<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>
    <p><%= projectDetail.description %></p>
    <p><strong>Commencement Date: </strong><%= projectDetail.project_date.toDateString() %></p>
    <p><strong>Location: </strong><%= projectDetail.location %></p>
    <p><strong>Organization Conducting Project: </strong><a href="/organization/<%= projectDetail.organization_id %>"><%= projectDetail.name %></a></p>
    <p><strong>Categories</strong></p>
    <p><% categories.forEach(category => { %> 
            <p><a href="/category/<%= category.category_id%>"><%= category.name %></a></p>
        <% }) %>
    </p>
    <% if (isLoggedIn && !isVolunteering) { %>
        <form action="/project/<%= projectDetail.project_id %>/volunteer" method="post">
            <button type="submit">Volunteer for Project</button>
        </form>
    <% } %>
    <% if (isLoggedIn && isVolunteering) { %>
        <h3>You are Volunteering</h3>
        <form action="/project/<%= projectDetail.project_id %>/unvolunteer" method="post">
            <button type="submit">Remove Self as Volunteer</button>
        </form>
    <% } %>
    <% if (user && user.role_name === 'admin') { %>
        <a href="/assign-categories/<%= projectDetail.project_id %>" class="btn">Edit Categories</a>
        <a href="/edit-project/<%= projectDetail.project_id %>" class="btn">Edit Projects</a>
    <% } %>
</main>

<%- include('partials/footer') %>